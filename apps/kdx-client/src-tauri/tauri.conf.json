{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KDX",
  "version": "0.1.0",
  "identifier": "net.kdx.hotline.client",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KDX",
        "width": 208,
        "height": 540,
        "resizable": false,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Hotline-style chat and file sharing",
    "longDescription": "KDX is a modern rebuild of the early-2000s Hotline client — private servers, chat rooms, file browsing, and resumable transfers, all over TLS 1.3 with challenge-response auth.",
    "copyright": "© 2024–2026 theusual",
    "category": "SocialNetworking",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
